# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.149.1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    openssh-server \
  && npm install --global "@openai/codex@${CODEX_VERSION}" \
  && rm -rf /var/lib/apt/lists/* /root/.npm

RUN useradd --create-home --shell /bin/bash codex \
  && passwd --delete codex \
  && install -d -o codex -g codex \
    /home/codex/.codex/packages/standalone/current \
  && ln -s /usr/local/bin/codex \
    /home/codex/.codex/packages/standalone/current/codex \
  && chown -R codex:codex /home/codex/.codex \
  && install -d -m 755 /run/sshd /workspace \
  && chown codex:codex /workspace

COPY docker/remote-test-entrypoint.sh /usr/local/bin/remote-test-entrypoint

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/remote-test-entrypoint"]
